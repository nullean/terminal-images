<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime dependencies. The core package has none, by design: see AGENTS.md. Integration packages add their host here. -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Terminal.Gui" Version="2.5.0" />
    <PackageVersion Include="XenoAtom.Terminal" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test dependencies. TUnit and AwesomeAssertions track the latest stable release only. -->
    <PackageVersion Include="TUnit" Version="1.79.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
  </ItemGroup>
</Project>
